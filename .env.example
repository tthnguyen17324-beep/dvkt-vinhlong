# Sao chép thành file ".env" rồi điền giá trị thật. KHÔNG đưa file .env lên GitHub.

# Tên miền trỏ về máy chủ (ví dụ: giadvkt.example.vn)
DOMAIN=giadvkt.example.vn

# Mật khẩu quản trị mở "Bảng tổng hợp" (đặt chuỗi dài, khó đoán; thay cho SYT@2026 cũ)
ADMIN_PASSWORD=

# Liên kết sang web app "Thuyết minh Chi phí quản lý" (mục 6)
CPQL_APP_URL=https://script.google.com/macros/s/AKfycbztDkZyJ_JunRXNrAhKcySP4tJmHR_JZzdM80Yh5u0pIs7gLAaCIk4Qap44zytszkjN/exec

# --- (Tùy chọn) Tự tạo Google Sheet cho mỗi phiên nộp ---
# Để trống = tắt; báo cáo vẫn tải được dạng .xlsx. Xem mục 10 trong HUONG_DAN_TRIEN_KHAI.md
# Dán nguyên nội dung file JSON của tài khoản dịch vụ trên MỘT dòng, hoặc dùng GOOGLE_SERVICE_ACCOUNT_FILE
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# anyone = ai có link đều xem được (giống hệ thống cũ); none = chỉ người được chia sẻ
GOOGLE_SHEET_SHARE=anyone
